{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/app/shared/ui/spartan/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/shared/ui/spartan/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/shared/ui/spartan/card/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/app/shared/ui/spartan/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/app/shared/ui/spartan/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/shared/ui/spartan/separator/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/shared/ui/spartan/input/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/app/shared/ui/spartan/textarea/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/app/shared/ui/spartan/badge/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/app/shared/ui/spartan/checkbox/src/index.ts"],
      "@spartan-ng/helm/native-select": ["./src/app/shared/ui/spartan/native-select/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./src/app/shared/ui/spartan/skeleton/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
